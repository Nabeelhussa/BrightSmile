PORT=5000
NODE_ENV=development

# PostgreSQL connection string (used in production / Render)
# DATABASE_URL=postgresql://user:password@host:5432/dental_clinic

# Local SQLite database file path (used automatically when DATABASE_URL is not set)
SQLITE_PATH=./data/dental_clinic.db

# Enable SSL for managed PostgreSQL when required
DATABASE_SSL=false

# Allowed frontend origins (comma-separated)
CORS_ORIGIN=http://localhost:5173
