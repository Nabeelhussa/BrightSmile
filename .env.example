# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Relational Database Configuration
# Production / PostgreSQL example:
# DATABASE_URL=postgresql://username:password@hostname:5432/dental_clinic
# Local SQLite fallback (used automatically when DATABASE_URL is omitted):
SQLITE_PATH=./data/dental_clinic.db

# Set to true only if PostgreSQL requires SSL (e.g. Render external URL; Render internal usually handles or accepts rejectUnauthorized: false)
DATABASE_SSL=false

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173

# Frontend Configuration (in client/.env)
VITE_API_URL=http://localhost:5000/api
